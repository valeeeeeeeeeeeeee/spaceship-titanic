# Competition data — NOT redistributable.
# Kaggle's rules forbid providing the Competition Data to anyone who has not
# accepted them. Re-fetch instead: kagglehub.competition_download('spaceship-titanic')
data/*
!data/.gitkeep

# Submissions are derived from the data; regenerate them from src/inference.py
submissions/*
!submissions/.gitkeep

# Trained models
models/*
!models/.gitkeep
*.pkl
*.joblib
*.h5
*.onnx

# Any stray CSV outside data/ is assumed to be competition-derived
*.csv

# Credentials — never commit a Kaggle token
kaggle.json
.kaggle/
access_token
.env
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# OneDrive / Windows / editors
desktop.ini
Thumbs.db
*.lnk
~$*
.DS_Store
.vscode/
.idea/
